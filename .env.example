# Copy to .env (git-ignored) and fill in. Only TYPESAFE_API_KEY is needed for the standard audit.
TYPESAFE_API_KEY=
# Optional: raises the PageSpeed Insights rate limit (free key from Google Cloud).
PAGESPEED_API_KEY=
# Optional: only for --full mode (paid per call).
DATAFORSEO_USERNAME=
DATAFORSEO_PASSWORD=
